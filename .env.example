# Local API verification only — the app itself never reads this file.
# Ignite takes its token from the login screen and stores it in SharedPreferences.
#
# This exists so `curl` checks against the Codemagic API are reproducible.
# Keep the real token outside the repository, e.g. ~/.config/ignite/codemagic.env
# with mode 600. Get one at: Codemagic → User settings → Integrations → Codemagic API
CODEMAGIC_API_TOKEN=
